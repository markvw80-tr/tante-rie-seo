{% comment %} Tante Rie – Bakmix Product Page {% endcomment %}

{%- render 'tr-product-schema', product: product -%}

<style>
.tr-wrap *, .tr-wrap *::before, .tr-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
.tr-wrap {
  background: var(--cream); color: var(--text);
  font-family: 'DM Sans', sans-serif; font-size: 15px;
  line-height: 1.6; -webkit-font-smoothing: antialiased;
}
.tr-breadcrumb { padding: 14px 5vw; font-size: 12px; color: var(--text-muted); letter-spacing: .04em; }
.tr-breadcrumb a { color: var(--text-muted); text-decoration: none; }
.tr-breadcrumb span { margin: 0 6px; }
.tr-product-grid { display: grid; grid-template-columns: 1fr 1fr; min-height: 90vh; }
.tr-gallery { position: sticky; top: var(--header-group-height, 64px); height: calc(100vh - var(--header-group-height, 64px)); display: flex; flex-direction: column; background: var(--page-bg); }
.tr-gallery-main { flex: 1; overflow: hidden; position: relative; background: var(--page-bg); }
.tr-gallery-main img { width: 100%; height: 100%; object-fit: contain; background: var(--page-bg); transition: transform .5s cubic-bezier(.25,.46,.45,.94); padding: 20px; }
.tr-gallery-main:hover img { transform: scale(1.03); }
.tr-gallery-badge { position: absolute; top: 16px; left: 16px; background: var(--white); border-radius: 50px; padding: 6px 14px; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--brown-dark); box-shadow: 0 2px 12px rgba(0,0,0,.08); }
.tr-gallery-badge-type { position: absolute; top: 16px; right: 16px; background: var(--green); border-radius: 50px; padding: 6px 14px; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--white); }
.tr-gallery-thumbs { flex-shrink: 0; display: flex; gap: 10px; padding: 12px 16px 14px; background: var(--page-bg); border-top: 1px solid rgba(0,0,0,.06); }
.tr-thumb { flex: 1; height: 72px; border-radius: 8px; cursor: pointer; background: var(--page-bg); overflow: hidden; box-shadow: 0 0 0 2px transparent; transition: box-shadow .2s; }
.tr-thumb.active { box-shadow: 0 0 0 2px var(--brown); }
.tr-thumb img { width: 100%; height: 100%; object-fit: contain; padding: 4px; background: var(--page-bg); display: block; }
.tr-product-info { padding: 48px 5vw 64px; overflow-y: auto; display: flex; flex-direction: column; }
.tr-tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
.tr-tag { background: var(--tag-bg); color: var(--brown-dark); font-size: 11px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; padding: 5px 12px; border-radius: 50px; }
.tr-product-info h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 400; line-height: 1.15; color: var(--brown-dark); margin-bottom: 10px; }
.tr-tagline { font-family: 'DM Sans', sans-serif; font-style: italic; font-size: 1rem; color: var(--text-muted); margin-bottom: 24px; }
.tr-rating-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
.tr-rating-bar a { font-size: 13px; color: var(--brown); text-decoration: none; border-bottom: 1px solid var(--brown-light); }
.tr-divider { width: 48px; height: 2px; background: var(--brown-light); margin: 0 0 28px; border-radius: 2px; }
.tr-section-label { font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px; }
.tr-bak-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 28px; }
.tr-bak-card { background: var(--white); border-radius: 14px; padding: 16px 14px; display: flex; flex-direction: column; align-items: center; gap: 6px; border: 1px solid var(--cream-dark); transition: transform .2s, box-shadow .2s; }
.tr-bak-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.07); }
.tr-bak-icon { width: 26px; height: 26px; stroke: var(--brown); fill: none; stroke-width: 1.6; }
.tr-bak-value { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--brown-dark); font-weight: 500; }
.tr-bak-label { font-size: 11px; color: var(--text-muted); letter-spacing: .04em; text-align: center; }
.tr-origin-block { background: var(--white); border-radius: 16px; padding: 20px 22px; margin-bottom: 28px; border-left: 3px solid var(--brown-light); }
.tr-origin-block p { font-family: 'Lora', serif; font-size: .95rem; line-height: 1.7; color: var(--text); margin-bottom: 10px; }
.tr-origin-block p:last-child { margin-bottom: 0; }
.tr-origin-block ul { font-family: 'Lora', serif; font-size: .95rem; line-height: 1.7; color: var(--text); padding-left: 18px; margin-bottom: 10px; }
.tr-origin-block li { margin-bottom: 4px; }
.tr-purchase-row { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
.tr-price { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--brown-dark); }
.tr-price-sub { font-size: 12px; color: var(--text-muted); line-height: 1.4; margin-top: 2px; }
.tr-qty-control { display: flex; align-items: center; border: 1px solid var(--cream-dark); border-radius: 50px; overflow: hidden; background: var(--white); }
.tr-qty-btn { width: 40px; height: 40px; background: none; border: none; cursor: pointer; font-size: 1.2rem; color: var(--brown-dark); display: flex; align-items: center; justify-content: center; transition: background .15s; }
.tr-qty-btn:hover { background: var(--cream-dark); }
.tr-qty-num { width: 32px; text-align: center; font-weight: 500; font-size: .95rem; color: var(--brown-dark); }
.tr-btn-primary { width: 100%; background: var(--brown-dark); color: var(--white); border: none; border-radius: 50px; padding: 17px 32px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; transition: background .2s, transform .15s; margin-bottom: 10px; display: block; }
.tr-btn-primary:hover { background: var(--brown); transform: translateY(-1px); }
.tr-btn-secondary { width: 100%; background: transparent; color: var(--brown-dark); border: 1.5px solid var(--brown-light); border-radius: 50px; padding: 15px 32px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; transition: background .2s; margin-bottom: 22px; display: block; }
.tr-btn-secondary:hover { background: var(--cream-dark); }
.tr-trust-strip { display: flex; gap: 18px; flex-wrap: wrap; margin-bottom: 32px; }
.tr-trust-item { font-size: 12px; color: var(--text-muted); }
.tr-accordion { border-top: 1px solid var(--cream-dark); }
.tr-accordion-item { border-bottom: 1px solid var(--cream-dark); }
.tr-accordion-trigger { width: 100%; background: none; border: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 16px 0; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; color: var(--brown-dark); text-align: left; }
.tr-accordion-body { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.tr-accordion-body.open { max-height: 400px; }
.tr-accordion-body p { padding: 0 0 16px; font-size: 13.5px; color: var(--text-muted); line-height: 1.7; }
.tr-chevron { font-size: 12px; color: var(--brown-light); transition: transform .25s; display: inline-block; }
.tr-accordion-trigger.open .tr-chevron { transform: rotate(180deg); }
.tr-combine-section { background: var(--white); padding: 48px 5vw; border-top: 1px solid var(--cream-dark); }
.tr-section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; }
.tr-section-title { font-family: 'Playfair Display', serif; font-size: 1.7rem; font-weight: 400; color: var(--brown-dark); }
.tr-see-all { font-size: 13px; color: var(--brown); text-decoration: none; border-bottom: 1px solid var(--brown-light); }
.tr-product-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.tr-product-card { background: var(--cream); border-radius: 16px; overflow: hidden; border: 1px solid var(--cream-dark); transition: transform .2s, box-shadow .2s; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
.tr-product-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,.08); }
.tr-card-img { aspect-ratio: 1; overflow: hidden; background: var(--page-bg); }
.tr-card-img img { width: 100%; height: 100%; object-fit: contain; padding: 8px; transition: transform .4s; }
.tr-product-card:hover .tr-card-img img { transform: scale(1.04); }
.tr-card-body { padding: 14px 14px 16px; flex: 1; display: flex; flex-direction: column; }
.tr-card-name { font-family: 'Lora', serif; font-size: .95rem; color: var(--brown-dark); margin-bottom: 4px; font-weight: 400; }
.tr-card-type { font-size: 11px; color: var(--text-muted); margin-bottom: 8px; letter-spacing: .04em; }
.tr-card-price { font-size: .9rem; color: var(--brown); font-weight: 500; margin-top: auto; }
.tr-card-btn { margin-top: 10px; background: var(--brown-dark); color: var(--white); border: none; border-radius: 50px; padding: 9px 0; width: 100%; font-size: 12px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background .2s; }
.tr-card-btn:hover { background: var(--brown); }
@media (max-width: 900px) {
  .tr-product-grid { grid-template-columns: 1fr; }
  .tr-gallery { position: relative; height: auto; top: 0; }
  .tr-gallery-main { height: 75vw; }
  .tr-product-cards { grid-template-columns: repeat(2,1fr); }
  .tr-bak-grid { grid-template-columns: repeat(3,1fr); }
}
/* Variants */
.tr-variants { margin-bottom: 22px; }
.tr-variant-label { font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px; }
.tr-variant-label strong { color: var(--brown-dark); font-weight: 600; text-transform: none; letter-spacing: 0; font-size: 13px; }
.tr-variant-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.tr-variant-pill { border: 1.5px solid var(--cream-dark); border-radius: 50px; padding: 8px 18px; min-height: 44px; display: inline-flex; align-items: center; font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--brown-dark); background: var(--white); cursor: pointer; transition: border-color .2s, background .2s; white-space: nowrap; }
.tr-variant-pill:hover { border-color: var(--brown-light); }
.tr-variant-pill.active { border-color: var(--brown-dark); background: var(--brown-dark); color: var(--white); }
.tr-variant-pill.unavailable { opacity: .4; cursor: not-allowed; text-decoration: line-through; }
/* Sticky ATC mobiel */
@media (max-width: 700px) {
  .tr-sticky-atc { display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; background: var(--white); border-top: 1px solid var(--cream-dark); padding: 12px 16px; gap: 10px; align-items: center; box-shadow: 0 -4px 20px rgba(0,0,0,.08); }
  .tr-sticky-atc-price { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--brown-dark); white-space: nowrap; }
  .tr-sticky-atc-btn { flex: 1; background: var(--brown-dark); color: var(--white); border: none; border-radius: 50px; padding: 14px 20px; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; }
  .tr-product-info { padding-bottom: 80px; }
}
@media (min-width: 701px) { .tr-sticky-atc { display: none; } }
</style>

<div class="tr-wrap">
  {%- assign cur = product -%}
  {%- assign bak_temp = section.settings.bak_temp | default: '160 °C' -%}
  {%- assign bak_tijd = section.settings.bak_tijd | default: '55 min' -%}
  {%- assign bak_gewicht = section.settings.bak_gewicht | default: '500 gram' -%}

  <div class="tr-breadcrumb">
    <a href="/">Home</a><span>›</span>
    {%- for c in cur.collections limit:1 -%}<a href="{{ c.url }}">{{ c.title }}</a><span>›</span>{%- endfor -%}
    {{ cur.title }}
  </div>

  <div class="tr-product-grid">
    <div class="tr-gallery">
      <div class="tr-gallery-main">
        <img id="tr-main-img"
             src="{{ cur.featured_image | image_url: width: 900 }}"
             alt="{{ cur.featured_image.alt | default: cur.title | escape }}"
             width="900" height="900"
             fetchpriority="high">
        <div class="tr-gallery-badge">{{ cur.variants.first.weight | weight_with_unit }}</div>
        <div class="tr-gallery-badge-type">Bakmix</div>
      </div>
      <div class="tr-gallery-thumbs">
        {%- for img in cur.images limit: 4 -%}
          <div class="tr-thumb {% if forloop.first %}active{% endif %}" onclick="trSwitchImg(this,'{{ img | image_url: width: 900 }}')">
            <img src="{{ img | image_url: width: 200 }}" alt="{{ cur.title | escape }}" width="200" height="200" loading="lazy">
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="tr-product-info">
      <div class="tr-tag-row">
        {%- for tag in cur.tags limit: 4 -%}<span class="tr-tag">{{ tag }}</span>{%- endfor -%}
      </div>
      <h1>{{ cur.title }}</h1>
      <p class="tr-tagline">{{ section.settings.tagline | default: 'Bakmix van Bakzolder – bij Tante Rie' }}</p>

      <div class="tr-rating-bar">
        {%- render 'judgeme_widgets', widget_type: 'judgeme_product_stars', concierge_install: true, product: cur -%}
        <a href="#tr-reviews">Bekijk beoordelingen</a>
      </div>
      <div class="tr-divider"></div>

      {%- if cur.variants.size > 1 -%}
        <script type="application/json" id="tr-bak-variant-data-{{ cur.id }}">
          {
            "variants": [
              {%- for v in cur.variants -%}
                {%- if v.featured_image -%}{%- assign v_img = v.featured_image | image_url: width: 900 -%}{%- else -%}{%- assign v_img = '' -%}{%- endif -%}
                {
                  "id": {{ v.id }},
                  "price": {{ v.price }},
                  "available": {{ v.available }},
                  "title": {{ v.title | json }},
                  "options": {{ v.options | json }},
                  "img": {{ v_img | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ],
            "fallbackImg": {{ cur.featured_image | image_url: width: 900 | json }},
            "initialOptions": {{ cur.selected_or_first_available_variant.options | json }}
          }
        </script>
        <div class="tr-variants" data-tr-bak-variants data-product-id="{{ cur.id }}">
          {%- for opt in cur.options_with_values -%}
            {%- assign opt_idx = forloop.index0 -%}
            {%- assign opt_selected = cur.selected_or_first_available_variant.options[opt_idx] -%}
            <div class="tr-variants-group" data-option-index="{{ opt_idx }}">
              <p class="tr-variant-label">{{ opt.name }}: <strong data-tr-bak-option-val="{{ opt_idx }}">{{ opt_selected }}</strong></p>
              <div class="tr-variant-pills">
                {%- for val in opt.values -%}
                  {%- assign is_active = false -%}
                  {%- if val == opt_selected -%}{%- assign is_active = true -%}{%- endif -%}
                  <button type="button"
                          class="tr-variant-pill{% if is_active %} active{% endif %}"
                          data-tr-bak-pill
                          data-option-index="{{ opt_idx }}"
                          data-value="{{ val | escape }}">{{ val }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <p class="tr-section-label">Bakadvies</p>
      <div class="tr-bak-grid">
        <div class="tr-bak-card">
          <svg class="tr-bak-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13.5V4a2 2 0 1 1 4 0v9.5a4 4 0 1 1-4 0Z"/><path d="M12 8v6"/></svg>
          <span class="tr-bak-value">{{ bak_temp }}</span>
          <span class="tr-bak-label">oventemperatuur</span>
        </div>
        <div class="tr-bak-card">
          <svg class="tr-bak-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M9 2h6M12 2v3"/></svg>
          <span class="tr-bak-value">{{ bak_tijd }}</span>
          <span class="tr-bak-label">baktijd</span>
        </div>
        <div class="tr-bak-card">
          <svg class="tr-bak-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8l9-5 9 5-9 5-9-5Z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/></svg>
          <span class="tr-bak-value">{{ bak_gewicht }}</span>
          <span class="tr-bak-label">inhoud</span>
        </div>
      </div>

      <div class="tr-origin-block">
        <p class="tr-section-label" style="margin-bottom:8px;">Het verhaal</p>
        {%- if section.settings.verhaal_tekst != blank -%}
          <p>{{ section.settings.verhaal_tekst }}</p>
        {%- else -%}
          {{ cur.descriptionHtml }}
        {%- endif -%}
      </div>

      <div class="tr-purchase-row">
        <div>
          <div class="tr-price">{{ cur.price | money }}</div>
          <div class="tr-price-sub">Belasting inbegrepen</div>
        </div>
        <div class="tr-qty-control">
          <button class="tr-qty-btn" onclick="trChangeQty(-1)">&#8722;</button>
          <span class="tr-qty-num" id="tr-qty">1</span>
          <button class="tr-qty-btn" onclick="trChangeQty(1)">+</button>
        </div>
      </div>

      <form action="/cart/add" method="post" id="tr-product-form" style="display:none;">
        <input type="hidden" name="id" value="{{ cur.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
      </form>

      <button type="button" class="tr-btn-primary" data-tr-atc data-qty-from="#tr-qty" data-variant-id="{{ cur.selected_or_first_available_variant.id }}">Aan winkelwagen toevoegen</button>
      <button class="tr-btn-secondary">&#9825; Op verlanglijst</button>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}></div>
      {%- endfor -%}

      <div class="tr-trust-strip">
        <span class="tr-trust-item">&#10003; Snel verzonden</span>
        <span class="tr-trust-item">&#10003; Van Bakzolder</span>
        <span class="tr-trust-item">&#10003; Uit eigen winkel Borne</span>
        <span class="tr-trust-item">&#10003; Altijd vers</span>
      </div>

      <div class="tr-accordion" data-tr-accordion>
        <div class="tr-accordion-item">
          <button class="tr-accordion-trigger" data-tr-accordion-trigger aria-expanded="false">Ingrediënten <span class="tr-chevron">&#9662;</span></button>
          <div class="tr-accordion-body" data-tr-accordion-body>
            <p>Zie de productbeschrijving of verpakking voor de volledige ingrediëntenlijst en allergeneninformatie.</p>
          </div>
        </div>
        <div class="tr-accordion-item">
          <button class="tr-accordion-trigger" data-tr-accordion-trigger aria-expanded="false">Bewaren <span class="tr-chevron">&#9662;</span></button>
          <div class="tr-accordion-body" data-tr-accordion-body><p>Bewaar op een koele, droge plek. Na openen in een luchtdichte verpakking bewaren en zo snel mogelijk gebruiken.</p></div>
        </div>
        <div class="tr-accordion-item">
          <button class="tr-accordion-trigger" data-tr-accordion-trigger aria-expanded="false">Verzending &amp; retour <span class="tr-chevron">&#9662;</span></button>
          <div class="tr-accordion-body" data-tr-accordion-body><p>Bestellingen worden dezelfde werkdag verwerkt. Bakmixen zijn een voedingsproduct en kunnen niet worden geretourneerd.</p></div>
        </div>
      </div>
    </div>
  </div>

  <section class="tr-combine-section">
    <div class="tr-section-header">
      <h2 class="tr-section-title">Meer bakmixen ontdekken</h2>
      <a href="/collections/bakmixen" class="tr-see-all">Alles bekijken</a>
    </div>
    <div class="tr-product-cards">
      {%- assign shown = 0 -%}
      {%- for p in collections['bakmixen'].products -%}
        {%- if p.id != cur.id and shown < 4 -%}{%- assign shown = shown | plus: 1 -%}
          <a class="tr-product-card" href="{{ p.url }}">
            <div class="tr-card-img"><img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy"></div>
            <div class="tr-card-body">
              <p class="tr-card-type">Bakmix</p>
              <p class="tr-card-name">{{ p.title }}</p>
              <p class="tr-card-price">{{ p.price | money }}</p>
              <button class="tr-card-btn">Toevoegen</button>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

</div>

<div class="tr-sticky-atc" id="tr-bak-sticky-atc">
  <div>
    <div class="tr-sticky-atc-price" id="tr-bak-sticky-price">{{ cur.price | money }}</div>
  </div>
  <button type="button" class="tr-sticky-atc-btn" data-tr-atc data-qty-from="#tr-qty" data-variant-id="{{ cur.selected_or_first_available_variant.id }}">In winkelwagen</button>
</div>

<script>
function trSwitchImg(el,src){document.getElementById('tr-main-img').src=src;document.querySelectorAll('.tr-thumb').forEach(t=>t.classList.remove('active'));el.classList.add('active');}
function trChangeQty(d){const e=document.getElementById('tr-qty');e.textContent=Math.max(1,parseInt(e.textContent)+d);}

(function(){
  const wrap = document.querySelector('[data-tr-bak-variants]');
  if(!wrap) return;

  const productId = wrap.dataset.productId;
  const dataEl = document.getElementById('tr-bak-variant-data-' + productId);
  if(!dataEl) return;

  let parsed;
  try { parsed = JSON.parse(dataEl.textContent); } catch(e) { return; }

  const variants = parsed.variants || [];
  const fallbackImg = parsed.fallbackImg || '';
  if(!variants.length) return;

  const currentOptions = parsed.initialOptions.slice();

  function findVariant(opts) {
    return variants.find(v => opts.every((o, i) => v.options[i] === o)) || null;
  }

  function updateUI(variant) {
    if(!variant) return;
    const priceEl = document.querySelector('.tr-price');
    if(priceEl) priceEl.textContent = (variant.price / 100).toLocaleString('nl-NL', {style:'currency', currency:'EUR'});
    document.querySelectorAll('[data-tr-atc][data-variant-id]').forEach(btn => {
      btn.dataset.variantId = variant.id;
      btn.disabled = !variant.available;
      btn.textContent = variant.available ? 'Aan winkelwagen toevoegen' : 'Uitverkocht';
    });
    const stickyPrice = document.getElementById('tr-bak-sticky-price');
    if(stickyPrice) stickyPrice.textContent = (variant.price / 100).toLocaleString('nl-NL', {style:'currency', currency:'EUR'});
    const imgSrc = (variant.img && variant.img.length > 10) ? variant.img : fallbackImg;
    if(imgSrc) {
      const mainImg = document.getElementById('tr-main-img');
      if(mainImg) mainImg.src = imgSrc;
      document.querySelectorAll('.tr-thumb').forEach(t => t.classList.remove('active'));
    }
  }

  function selectOption(optionIndex, value) {
    currentOptions[optionIndex] = value;
    const labelEl = document.querySelector('[data-tr-bak-option-val="'+optionIndex+'"]');
    if(labelEl) labelEl.textContent = value;
    wrap.querySelectorAll('[data-option-index="'+optionIndex+'"]').forEach(el => {
      el.classList.toggle('active', el.dataset.value === value);
    });
    updateUI(findVariant(currentOptions));
  }

  wrap.addEventListener('click', e => {
    const pill = e.target.closest('[data-tr-bak-pill]');
    if(pill) selectOption(parseInt(pill.dataset.optionIndex), pill.dataset.value);
  });
})();
</script>

