      "label": "Hero achtergrondafbeelding",
      "info": "Fallback als de collectie zelf geen afbeelding heeft"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Brand story afbeelding"
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Brand story tekst",
      "info": "Laat leeg voor standaard tekst over Blond Amsterdam"
    },
    {
      "type": "richtext",
      "id": "seo_text",
      "label": "SEO tekst (alternatief voor beschrijving)",
      "info": "Wordt getoond als de collectiebeschrijving geen tweede alinea heeft"
    }
  ]
}
{% endschema %}
