      <div class="trba-pickup-card">
        <div class="trba-pickup-icon" aria-hidden="true">{%- render 'tr-icon', name: 'clock' -%}</div>
        <h3>Openingstijden</h3>
        {%- assign days  = 'Maandag,Dinsdag,Woensdag,Donderdag,Vrijdag,Zaterdag,Zondag' | split: ',' -%}
        {%- assign hours = 'Gesloten,10:00 – 17:00,10:00 – 17:00,10:00 – 17:00,10:00 – 17:00,10:00 – 17:00,Gesloten' | split: ',' -%}
        {%- for day in days -%}
          {%- assign _h = hours[forloop.index0] -%}
          <div class="trba-hours-row">
            <span class="day">{{ day }}</span>
