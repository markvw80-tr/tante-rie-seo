{% comment %} Tante Rie – Blond Amsterdam Collectie Landingspagina {% endcomment %}

<style>
/* ─── Blond Amsterdam design tokens ─────────────────────────────────────── */
:root {
  --ba-orange:       #E8632A;
  --ba-orange-mid:   #F08C5A;
  --ba-orange-light: #FEF0E8;
  --ba-orange-dark:  #B84A18;
  --ba-yellow:       #F5C842;
  --ba-pink:         #F2A7C3;
}

/* ─── Wrapper ────────────────────────────────────────────────────────────── */
.trba-wrap *, .trba-wrap *::before, .trba-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
.trba-wrap { background: var(--cream); color: var(--text); font-family: 'DM Sans', sans-serif; font-size: 15px; line-height: 1.6; -webkit-font-smoothing: antialiased; min-height: 100vh; }

/* ─── Hero ───────────────────────────────────────────────────────────────── */
.trba-hero { position: relative; background: var(--ba-orange-dark); overflow: hidden; }
.trba-hero-bg { position: absolute; inset: 0; background: linear-gradient(135deg, var(--ba-orange-dark) 0%, var(--ba-orange) 60%, var(--ba-orange-mid) 100%); }
.trba-hero-pattern { position: absolute; inset: 0; opacity: .08; background-image: radial-gradient(circle at 25% 40%, #fff 1.5px, transparent 1.5px), radial-gradient(circle at 75% 20%, #fff 1px, transparent 1px), radial-gradient(circle at 55% 75%, #fff 2px, transparent 2px); background-size: 52px 52px, 80px 80px, 64px 64px; }
.trba-hero-img { position: absolute; inset: 0; }
.trba-hero-img img { width: 100%; height: 100%; object-fit: cover; opacity: .2; }
.trba-hero-inner { position: relative; z-index: 1; padding: 52px var(--page-margin) 48px; max-width: 760px; }
.trba-breadcrumb { font-size: 12px; color: rgba(255,255,255,.6); letter-spacing: .04em; margin-bottom: 18px; }
.trba-breadcrumb a { color: rgba(255,255,255,.6); text-decoration: none; }
.trba-breadcrumb a:hover { color: #fff; }
.trba-breadcrumb span { margin: 0 6px; }
.trba-hero-label { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.25); border-radius: 50px; padding: 5px 14px; font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.9); margin-bottom: 18px; }
.trba-hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; color: #fff; line-height: 1.15; margin-bottom: 14px; }
.trba-hero-sub { font-family: 'DM Sans', sans-serif; font-style: italic; font-size: 1rem; color: rgba(255,255,255,.8); margin-bottom: 28px; line-height: 1.6; max-width: 560px; }
.trba-hero-meta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.trba-hero-count { font-size: 13px; color: rgba(255,255,255,.65); }
.trba-hero-loc { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.12); border-radius: 50px; padding: 5px 14px; font-size: 12px; color: rgba(255,255,255,.85); }

/* ─── Sticky bar ─────────────────────────────────────────────────────────── */
.trba-sticky-bar { position: sticky; top: var(--header-group-height, 64px); transition: top var(--animation-speed-slow, .3s) var(--ease-out-cubic, ease); z-index: 7; background: var(--ba-orange-light); box-shadow: 0 2px 12px rgba(0,0,0,.07); }

/* ─── USP bar ────────────────────────────────────────────────────────────── */
.trba-usp-bar { background: var(--ba-orange-light); border-bottom: 1px solid rgba(232,99,42,.15); position: sticky; top: var(--header-group-height, 64px); transition: top var(--animation-speed-slow, .3s) var(--ease-out-cubic, ease); z-index: 7; box-shadow: 0 -4px 0 4px var(--ba-orange-light); }
.trba-usp-inner { display: flex; align-items: stretch; justify-content: center; flex-wrap: wrap; gap: 0; }
.trba-usp-item { display: flex; align-items: center; gap: 12px; padding: 18px 32px; border-right: 1px solid rgba(232,99,42,.15); flex: 1; min-width: 200px; }
.trba-usp-item:last-child { border-right: none; }
.trba-usp-icon { font-size: 1.4rem; flex-shrink: 0; }
.trba-usp-text strong { display: block; font-size: 13px; font-weight: 600; color: var(--ba-orange-dark); }
.trba-usp-text span { font-size: 12px; color: var(--ba-orange); }
@media (max-width: 700px) { .trba-usp-item { border-right: none; border-bottom: 1px solid rgba(232,99,42,.15); padding: 14px 20px; } .trba-usp-item:last-child { border-bottom: none; } }

/* ─── Category quick-nav ─────────────────────────────────────────────────── */
.trba-cat-nav { padding: 20px var(--page-margin) 0; overflow-x: auto; display: flex; gap: 8px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.trba-cat-nav::-webkit-scrollbar { display: none; }
.trba-cat-pill { display: inline-flex; align-items: center; white-space: nowrap; border: 1.5px solid var(--cream-dark); border-radius: 50px; padding: 7px 18px; font-size: 12.5px; font-weight: 500; color: var(--brown-dark); background: var(--white); text-decoration: none; transition: border-color .2s, background .2s, color .2s; flex-shrink: 0; }
.trba-cat-pill:hover, .trba-cat-pill.active { border-color: var(--ba-orange); background: var(--ba-orange); color: #fff; }

/* ─── Filter toolbar ─────────────────────────────────────────────────────── */
.trba-filter-toolbar { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 12px var(--page-margin); border-bottom: 1px solid rgba(232,99,42,.15); margin-bottom: 0; flex-wrap: wrap; gap: 10px; background: transparent; }
.trba-filter-groups { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.trba-filter-pill-wrap { position: relative; }
.trba-filter-pill { border: 1.5px solid var(--cream-dark); border-radius: 50px; padding: 8px 16px; font-size: 13px; background: var(--white); cursor: pointer; display: flex; gap: 6px; align-items: center; font-family: 'DM Sans', sans-serif; color: var(--brown-dark); }
.trba-filter-pill.active { border-color: var(--brown-dark); background: var(--brown-dark); color: var(--white); }
.trba-filter-pill svg { transition: transform .2s; }
.trba-filter-pill[aria-expanded="true"] svg { transform: rotate(180deg); }
.trba-filter-dropdown { display: none; position: absolute; background: var(--white); border: 1px solid var(--cream-dark); border-radius: 14px; padding: 16px; min-width: 200px; z-index: 20; box-shadow: 0 8px 24px rgba(0,0,0,.1); top: calc(100% + 8px); left: 0; max-height: 280px; overflow-y: auto; }
.trba-filter-dropdown.open { display: block; }
.trba-filter-option { display: flex; gap: 8px; align-items: center; font-size: 13px; padding: 6px 0; cursor: pointer; font-family: 'DM Sans', sans-serif; color: var(--brown-dark); }
.trba-filter-option input { cursor: pointer; accent-color: var(--ba-orange); }
.trba-active-strip { display: flex; flex-wrap: wrap; gap: 8px; padding: 8px var(--page-margin) 10px; background: transparent; }
.trba-filter-chip { background: var(--ba-orange-light); border-radius: 50px; padding: 4px 12px; font-size: 12px; display: flex; gap: 6px; align-items: center; text-decoration: none; color: var(--ba-orange-dark); font-family: 'DM Sans', sans-serif; }
.trba-filter-sort { border: 1.5px solid var(--cream-dark); border-radius: 50px; padding: 8px 16px; font-size: 13px; background: var(--white); cursor: pointer; color: var(--brown-dark); font-family: 'DM Sans', sans-serif; appearance: none; -webkit-appearance: none; }
.trba-filter-overlay { display: none; position: fixed; inset: 0; z-index: 10; }
.trba-filter-overlay.open { display: block; }

/* ─── Product grid ───────────────────────────────────────────────────────── */
.trba-grid-wrap { padding: 28px var(--page-margin) 64px; position: relative; z-index: 0; }
.trba-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.trba-card { background: var(--white); border-radius: 18px; overflow: hidden; border: 1px solid var(--cream-dark); display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: transform .22s ease, box-shadow .22s ease; animation: trbaFadeUp .45s ease both; }
.trba-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(184,74,24,.1); }
@keyframes trbaFadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
.trba-card:nth-child(1) { animation-delay: .04s; }
.trba-card:nth-child(2) { animation-delay: .08s; }
.trba-card:nth-child(3) { animation-delay: .12s; }
.trba-card:nth-child(4) { animation-delay: .16s; }
.trba-card:nth-child(n+5) { animation-delay: .20s; }
.trba-card-img { aspect-ratio: 1; overflow: hidden; background: var(--page-bg); position: relative; display: block; }
.trba-card-img img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: transform .4s ease; display: block; }
.trba-card:hover .trba-card-img img { transform: scale(1.05); }

/* Stock badges */
.trba-badge { position: absolute; top: 12px; left: 12px; font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: 4px 10px; border-radius: 50px; }
.trba-badge--stock { background: #d5edd5; color: #2e6b2e; }
.trba-badge--order { background: var(--ba-orange-light); color: var(--ba-orange-dark); }

.trba-card-body { padding: 16px 16px 18px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
.trba-card-type { font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ba-orange); }
.trba-card-name { font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 600; color: var(--brown-dark); line-height: 1.3; }
.trba-card-desc { font-size: 12px; color: var(--text-muted); line-height: 1.55; margin-top: 4px; flex: 1; }
.trba-card-footer { display: flex; align-items: flex-end; justify-content: space-between; margin-top: auto; padding-top: 14px; gap: 8px; }
.trba-card-price { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--brown-dark); font-weight: 400; }
.trba-card-compare { font-size: .8rem; color: var(--text-muted); text-decoration: line-through; margin-left: 4px; }

/* Buttons op kaart */
.trba-btn-atc { background: var(--brown-dark); color: var(--white); border: none; border-radius: 50px; padding: 8px 16px; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background .2s, transform .15s; white-space: nowrap; text-decoration: none; display: inline-block; }
.trba-btn-atc:hover { background: var(--brown); transform: translateY(-1px); }
.trba-btn-order { background: var(--ba-orange); color: var(--white); border: none; border-radius: 50px; padding: 8px 16px; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background .2s; white-space: nowrap; text-decoration: none; display: inline-block; }
.trba-btn-order:hover { background: var(--ba-orange-dark); }

.trba-empty { text-align: center; padding: 80px var(--page-margin); color: var(--text-muted); }

/* ─── Brand story ────────────────────────────────────────────────────────── */
.trba-brand { background: var(--ba-orange-dark); color: #fff; padding: 64px var(--page-margin); }
.trba-brand-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; max-width: 1080px; margin: 0 auto; }
.trba-brand-label { font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ba-yellow); margin-bottom: 14px; }
.trba-brand h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 400; color: #fff; line-height: 1.25; margin-bottom: 20px; }
.trba-brand-text { font-size: .925rem; color: rgba(255,255,255,.8); line-height: 1.8; }
.trba-brand-text p { margin-bottom: 14px; }
.trba-brand-text p:last-child { margin-bottom: 0; }
.trba-brand-img { border-radius: 20px; overflow: hidden; aspect-ratio: 4/3; background: var(--ba-orange); }
.trba-brand-img img { width: 100%; height: 100%; object-fit: cover; }
.trba-brand-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 4rem; opacity: .3; }
@media (max-width: 768px) { .trba-brand-inner { grid-template-columns: 1fr; gap: 32px; } }

/* ─── Pickup info ────────────────────────────────────────────────────────── */
.trba-pickup { background: var(--cream); padding: 56px var(--page-margin); border-top: 1px solid var(--cream-dark); }
.trba-pickup-inner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.trba-pickup-card { background: var(--white); border-radius: 20px; padding: 28px 32px; border: 1px solid var(--cream-dark); display: flex; flex-direction: column; }
.trba-pickup-icon { font-size: 2rem; margin-bottom: 14px; }
.trba-pickup-card h3 { font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 400; color: var(--brown-dark); margin-bottom: 14px; }
.trba-hours-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; border-radius: 8px; font-size: 13px; }
.trba-hours-row:nth-child(odd) { background: var(--cream); }
.trba-hours-row .day { font-weight: 600; color: var(--brown-dark); }
.trba-hours-row .time { color: var(--text-muted); }
.trba-hours-row .time.closed { color: #c0392b; font-style: italic; }
.trba-pickup-address { font-size: 13.5px; color: var(--text); line-height: 1.8; }
.trba-pickup-address strong { color: var(--brown-dark); display: block; margin-bottom: 4px; font-size: 14px; }
.trba-pickup-map-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: 12px; color: var(--ba-orange); text-decoration: none; border-bottom: 1px solid rgba(232,99,42,.3); padding-bottom: 1px; }
.trba-pickup-map-link:hover { color: var(--ba-orange-dark); }
.trba-pickup-contact { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; flex: 1; }
.trba-pickup-contact-row { display: flex; align-items: flex-start; gap: 12px; font-size: 13.5px; color: var(--text); }
.trba-pickup-contact-row svg { flex-shrink: 0; margin-top: 2px; color: var(--ba-orange); }
.trba-pickup-contact-row a { color: var(--ba-orange); text-decoration: none; }
.trba-pickup-contact-row a:hover { text-decoration: underline; }
.trba-pickup-cta { margin-top: auto; padding-top: 20px; }
.trba-pickup-cta a { display: block; text-align: center; background: var(--ba-orange); color: var(--white); border-radius: 50px; padding: 12px 20px; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; text-decoration: none; transition: background .2s; }
.trba-pickup-cta a:hover { background: var(--ba-orange-dark); }
@media (max-width: 900px) { .trba-pickup-inner { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .trba-pickup-inner { grid-template-columns: 1fr; } }

/* ─── SEO text block ─────────────────────────────────────────────────────── */
.trba-seo { padding: 48px var(--page-margin) 64px; background: var(--page-bg); border-top: 1px solid var(--cream-dark); }
.trba-seo-inner h2, .trba-seo-inner h3 { font-family: 'Playfair Display', serif; font-weight: 400; color: var(--brown-dark); margin: 28px 0 10px; font-size: 1.3rem; line-height: 1.25; }
.trba-seo-inner h2:first-child, .trba-seo-inner h3:first-child { margin-top: 0; }
.trba-seo-inner p { font-size: .9rem; color: var(--text-muted); line-height: 1.85; margin-bottom: 14px; }
.trba-seo-inner a { color: var(--ba-orange); text-decoration: underline; text-underline-offset: 2px; }
.trba-seo-inner strong, .trba-seo-inner b { color: var(--brown-dark); font-weight: 600; }

/* ─── Responsive grid ────────────────────────────────────────────────────── */
@media (max-width: 1100px) { .trba-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 700px) { .trba-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } .trba-grid-wrap { padding: 24px 4vw 48px; } .trba-hero-inner { padding: 36px 4vw 32px; } .trba-usp-bar .trba-usp-inner { flex-direction: column; } .trba-usp-item { justify-content: center; text-align: center; } .trba-pickup { padding: 36px 4vw; } .trba-seo { padding: 36px 4vw 48px; } }
@media (max-width: 400px) { .trba-grid { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { .trba-wrap *, .trba-wrap *::before, .trba-wrap *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }
</style>

{%- comment -%} Collectiebeschrijving splitsen: eerste alinea in header, rest in SEO-blok onderaan {%- endcomment -%}
{%- if collection.description != blank -%}
  {%- assign _desc_parts = collection.description | split: '</p>' -%}
  {%- assign _desc_first = _desc_parts[0] | append: '</p>' -%}
  {%- assign _desc_rest = '' -%}
  {%- for _p in _desc_parts offset: 1 -%}
    {%- if _p != '' -%}{%- assign _desc_rest = _desc_rest | append: _p | append: '</p>' -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}

<div class="trba-wrap" itemscope itemtype="https://schema.org/CollectionPage">
  <meta itemprop="name" content="{{ collection.title }} – Tante Rie, Borne (Twente)">
  <meta itemprop="description" content="Blond Amsterdam woonaccessoires en cadeaus bij Tante Rie in Borne, Twente. Heel de collectie op bestelling beschikbaar. Afhalen in Borne, bereikbaar vanuit Enschede, Hengelo en Almelo.">

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="trba-hero" aria-label="{{ collection.title }} collectie">
    <div class="trba-hero-bg"></div>
    <div class="trba-hero-pattern"></div>
    {%- assign _hero_img = collection.image -%}
    {%- if _hero_img == blank and section.settings.hero_image != blank -%}
      {%- assign _hero_img = section.settings.hero_image -%}
    {%- endif -%}
    {%- if _hero_img -%}
      <div class="trba-hero-img">
        <img src="{{ _hero_img | image_url: width: 1600 }}" alt="{{ _hero_img.alt | default: collection.title | escape }}" loading="eager" width="1600" height="600">
      </div>
    {%- endif -%}
    <div class="trba-hero-inner">
      <nav class="trba-breadcrumb" aria-label="Kruimelpad">
        <a href="/">Home</a><span aria-hidden="true">›</span>
        <a href="/collections">Collecties</a><span aria-hidden="true">›</span>
        <span>{{ collection.title }}</span>
      </nav>
      <div class="trba-hero-label" aria-hidden="true">
        <span>{%- render 'tr-icon', name: 'flower' -%}</span> Vrolijk Dutch design
      </div>
      <h1 itemprop="headline">{{ collection.title }}</h1>
      <p class="trba-hero-sub">
        {%- if section.settings.subtitle != blank -%}
          {{ section.settings.subtitle }}
        {%- else -%}
          Kleurrijke woonaccessoires en cadeaus, te bestellen bij Tante Rie in <strong style="color:#fff">Borne</strong>
        {%- endif -%}
      </p>
      <div class="trba-hero-meta">
        <span class="trba-hero-count">{{ collection.products_count }} producten</span>
        <span class="trba-hero-loc"><span aria-hidden="true">{%- render 'tr-icon', name: 'pin' -%}</span> Bakkerssteeg 6, Borne</span>
      </div>
    </div>
  </section>

  <!-- ── Sticky bar (USP + filter) ───────────────────────────────────── -->
  <div class="trba-sticky-bar">

  <!-- ── USP bar ───────────────────────────────────────────────────────── -->
  <div class="trba-usp-bar" role="complementary" aria-label="Belangrijke informatie">
    <div class="trba-usp-inner">
      <div class="trba-usp-item">
        <span class="trba-usp-icon" aria-hidden="true">{%- render 'tr-icon', name: 'store' -%}</span>
        <div class="trba-usp-text">
          <strong>Alleen afhalen in Borne</strong>
          <span>Bakkerssteeg 6, 7622 GX Borne</span>
        </div>
      </div>
      <div class="trba-usp-item">
        <span class="trba-usp-icon" aria-hidden="true">{%- render 'tr-icon', name: 'clock' -%}</span>
        <div class="trba-usp-text">
          <strong>Openingstijden winkel</strong>
          <span>Di t/m za &nbsp;10:00 – 17:00 uur</span>
        </div>
      </div>
      <div class="trba-usp-item">
        <span class="trba-usp-icon" aria-hidden="true">{%- render 'tr-icon', name: 'package' -%}</span>
        <div class="trba-usp-text">
          <strong>Hele collectie op bestelling</strong>
          <span>Niet op voorraad? Gewoon bestelbaar</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Categorie quick-nav ───────────────────────────────────────────── -->
  {%- assign _type_filter = nil -%}
  {%- for f in collection.filters -%}
    {%- if f.param_name == 'filter.p.product_type' -%}{%- assign _type_filter = f -%}{%- endif -%}
  {%- endfor -%}
  {%- if _type_filter != nil and _type_filter.values.size > 1 -%}
    <nav class="trba-cat-nav" aria-label="Productcategorieën">
      <a href="{{ collection.url }}" class="trba-cat-pill{% unless request.path contains '?' %} active{% endunless %}">Alle producten</a>
      {%- for fv in _type_filter.values -%}
        <a href="{{ fv.url_to_add }}" class="trba-cat-pill{% if fv.active %} active{% endif %}">{{ fv.label }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <!-- ── Filter & sort ─────────────────────────────────────────────────── -->
  <div id="trba-filter-overlay" class="trba-filter-overlay"></div>
  <form id="trba-filter-form" action="{{ collection.url }}" method="get">
    <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
    <div class="trba-filter-toolbar">
      <div class="trba-filter-groups">
        {%- for filter in collection.filters -%}
          {%- if filter.param_name == 'filter.p.product_type' -%}{%- continue -%}{%- endif -%}
          {%- assign _has_active = false -%}
          {%- for fv in filter.values -%}{%- if fv.active -%}{%- assign _has_active = true -%}{%- endif -%}{%- endfor -%}
          <div class="trba-filter-pill-wrap">
            <button type="button" class="trba-filter-pill{% if _has_active %} active{% endif %}" aria-expanded="false" data-trba-pill>
              {{ filter.label }}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="trba-filter-dropdown" data-trba-dropdown>
              {%- for fv in filter.values -%}
                <label class="trba-filter-option">
                  <input type="checkbox" name="{{ filter.param_name }}" value="{{ fv.value }}"{% if fv.active %} checked{% endif %}>
                  {{ fv.label }}
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      <select class="trba-filter-sort" name="sort_by" aria-label="Sorteren" data-trba-sort>
        {%- assign _cur_sort = collection.sort_by | default: collection.default_sort_by -%}
        <option value="created-descending"{% if _cur_sort == 'created-descending' %} selected{% endif %}>Nieuwste eerst</option>
        <option value="price-ascending"{% if _cur_sort == 'price-ascending' %} selected{% endif %}>Prijs: laag → hoog</option>
        <option value="price-descending"{% if _cur_sort == 'price-descending' %} selected{% endif %}>Prijs: hoog → laag</option>
        <option value="title-ascending"{% if _cur_sort == 'title-ascending' %} selected{% endif %}>Naam: A → Z</option>
        <option value="title-descending"{% if _cur_sort == 'title-descending' %} selected{% endif %}>Naam: Z → A</option>
      </select>
    </div>
    {%- assign _any_active = false -%}
    {%- for f in collection.filters -%}{%- for fv in f.values -%}{%- if fv.active -%}{%- assign _any_active = true -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
    {%- if _any_active -%}
      <div class="trba-active-strip">
        {%- for f in collection.filters -%}
          {%- for fv in f.values -%}
            {%- if fv.active -%}
              <a href="{{ fv.url_to_remove }}" class="trba-filter-chip">{{ fv.label }} <span aria-hidden="true">×</span></a>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </form>

  </div><!-- /trba-sticky-bar -->

  <!-- ── Product grid ──────────────────────────────────────────────────── -->
  {%- assign _filter_voorraad = false -%}
  {%- for f in collection.filters -%}
    {%- if f.param_name == 'filter.v.availability' -%}
      {%- for fv in f.values -%}
        {%- if fv.active and fv.value == '1' -%}{%- assign _filter_voorraad = true -%}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="trba-grid-wrap">
    {%- if collection.products.size > 0 -%}
      <div class="trba-grid" role="list" aria-label="Blond Amsterdam producten">
        {%- for product in collection.products -%}
          {%- assign _available = product.available -%}
          {%- assign _kaart_tekst = product.metafields.custom.samenvatting -%}

          {%- assign _card_img = product.featured_image -%}
          {%- assign _card_variant_url = product.url -%}
          {%- if _filter_voorraad -%}
            {%- for v in product.variants -%}
              {%- if v.available -%}
                {%- if v.featured_image -%}{%- assign _card_img = v.featured_image -%}{%- endif -%}
                {%- assign _card_variant_url = product.url | append: '?variant=' | append: v.id -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          <article class="trba-card" role="listitem" itemscope itemtype="https://schema.org/Product">
            <a href="{{ _card_variant_url }}" class="trba-card-img" aria-label="{{ product.title }}">
              {%- if _card_img -%}
                <img
                  src="{{ _card_img | image_url: width: 500 }}"
                  alt="{{ _card_img.alt | default: product.title | escape }} – Blond Amsterdam bij Tante Rie Borne"
                  loading="lazy"
                  width="500"
                  height="500"
                  itemprop="image">
              {%- else -%}
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:3rem;opacity:.2" aria-hidden="true">{%- render 'tr-icon', name: 'flower', size: 48 -%}</div>
              {%- endif -%}
              {%- if _available -%}
                <span class="trba-badge trba-badge--stock" aria-label="Op voorraad">Op voorraad</span>
              {%- else -%}
                <span class="trba-badge trba-badge--order" aria-label="Op bestelling beschikbaar">Te bestellen</span>
              {%- endif -%}
            </a>
            <div class="trba-card-body">
              {%- if product.type != blank -%}
                <span class="trba-card-type" itemprop="category">{{ product.type }}</span>
              {%- endif -%}
              <a href="{{ _card_variant_url }}" style="text-decoration:none">
                <p class="trba-card-name" itemprop="name">{{ product.title }}</p>
              </a>
              {%- if _kaart_tekst != blank -%}
                <p class="trba-card-desc">{{ _kaart_tekst }}</p>
              {%- endif -%}
              <div class="trba-card-footer">
                <span class="trba-card-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                  <meta itemprop="priceCurrency" content="EUR">
                  <meta itemprop="price" content="{{ product.price | divided_by: 100.0 }}">
                  {%- if product.variants.size > 1 -%}<span style="font-size:.75rem;font-weight:400;color:var(--text-muted);display:block;letter-spacing:.02em">Prijs vanaf</span>{%- endif -%}
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="trba-card-compare">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </span>
                {%- if _available -%}
                  <button class="trba-btn-atc" data-tr-atc data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="Voeg {{ product.title }} toe aan winkelwagen">
                    In winkelwagen
                  </button>
                {%- else -%}
                  <a href="{{ _card_variant_url }}" class="trba-btn-order" aria-label="Bestel {{ product.title }}">Bestel nu</a>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="trba-empty" role="status">
        <p>Geen producten gevonden met deze filters. <a href="{{ collection.url }}" style="color:var(--ba-orange)">Wis filters</a></p>
      </div>
    {%- endif -%}
  </div>

  <!-- ── Brand story ───────────────────────────────────────────────────── -->
  <section class="trba-brand" aria-labelledby="trba-brand-heading">
    <div class="trba-brand-inner">
      <div>
        <p class="trba-brand-label">Over het merk</p>
        <h2 id="trba-brand-heading">Blond Amsterdam – Kleur in je leven</h2>
        <div class="trba-brand-text">
          {%- if section.settings.brand_text != blank -%}
            {{ section.settings.brand_text }}
          {%- else -%}
            <p>Blond Amsterdam maakt vrolijke woonaccessoires, servies en cadeaus met een herkenbare stijl: kleurrijk, eigenzinnig en altijd een beetje grappig. Het merk ontstond in Amsterdam en is inmiddels niet meer weg te denken uit de Nederlandse huiskamer.</p>
            <p>Bij Tante Rie vind je mokken, borden, schalen, textiel en cadeau-artikelen uit de Blond Amsterdam collectie. Staat iets er niet? Bestel het gewoon. Je haalt het op als het er ligt.</p>
            <p>Borne ligt midden in Twente, op een halfuur van <strong>Enschede, Hengelo en Almelo</strong>. Loop binnen, kijk rond.</p>
          {%- endif -%}
        </div>
      </div>
      <div class="trba-brand-img">
        {%- if section.settings.brand_image != blank -%}
          <img src="{{ section.settings.brand_image | image_url: width: 800 }}" alt="Blond Amsterdam collectie bij Tante Rie Borne Twente" loading="lazy" width="800" height="600">
        {%- else -%}
          <div class="trba-brand-img-placeholder" aria-hidden="true">{%- render 'tr-icon', name: 'flower' -%}</div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- ── Ophaalinformatie ──────────────────────────────────────────────── -->
  <section class="trba-pickup" aria-labelledby="trba-pickup-heading">
    <h2 id="trba-pickup-heading" style="font-family:'Playfair Display',serif;font-size:clamp(1.5rem,2.5vw,2rem);font-weight:400;color:var(--brown-dark);margin-bottom:28px;">Alleen afhalen in de winkel</h2>
    <div class="trba-pickup-inner">
      <div class="trba-pickup-card">
        <div class="trba-pickup-icon" aria-hidden="true">{%- render 'tr-icon', name: 'pin' -%}</div>
        <h3>Winkeladres</h3>
        <div class="trba-pickup-address">
          <strong>Tante Rie</strong>
          <span>Bakkerssteeg 6</span><br>
          <span>7622 GX</span> <span>Borne</span><br>
          <span>Twente</span>
        </div>
        <a href="https://maps.google.com/?q=Bakkerssteeg+6+Borne" class="trba-pickup-map-link" target="_blank" rel="noopener" aria-label="Open in Google Maps">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Routebeschrijving in Google Maps
