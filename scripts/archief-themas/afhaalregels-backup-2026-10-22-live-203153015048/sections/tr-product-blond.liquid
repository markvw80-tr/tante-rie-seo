{% comment %} Tante Rie – Blond Amsterdam Productpagina {% endcomment %}

<style>
/* ─── Blond Amsterdam tokens ─────────────────────────────────────────────── */
:root {
  --ba-orange:       #E8632A;
  --ba-orange-mid:   #F08C5A;
  --ba-orange-light: #FEF0E8;
  --ba-orange-dark:  #B84A18;
  --ba-yellow:       #F5C842;
}

/* ─── Layout ─────────────────────────────────────────────────────────────── */
.trbap-wrap *, .trbap-wrap *::before, .trbap-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
.trbap-wrap { background: var(--cream); color: var(--text); font-family: 'DM Sans', sans-serif; font-size: 15px; line-height: 1.6; -webkit-font-smoothing: antialiased; }

.trbap-grid { display: grid; grid-template-columns: 1fr 1fr; min-height: 90vh; }

/* ─── Gallery ────────────────────────────────────────────────────────────── */
.trbap-gallery { position: sticky; top: var(--header-group-height, 64px); height: calc(100vh - var(--header-group-height, 64px)); display: flex; flex-direction: column; background: var(--page-bg); }
.trbap-gallery-main { flex: 1; overflow: hidden; position: relative; background: var(--page-bg); }
.trbap-gallery-main img { width: 100%; height: 100%; object-fit: contain; padding: 24px; transition: transform .5s cubic-bezier(.25,.46,.45,.94); background: var(--page-bg); }
.trbap-gallery-main:hover img { transform: scale(1.03); }
.trbap-gallery-badge { position: absolute; top: 16px; left: 16px; background: var(--white); border-radius: 50px; padding: 6px 14px; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ba-orange-dark); box-shadow: 0 2px 12px rgba(0,0,0,.08); }
.trbap-gallery-brand { position: absolute; top: 16px; right: 16px; background: var(--ba-orange); border-radius: 50px; padding: 6px 14px; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--white); }
.trbap-gallery-thumbs { flex-shrink: 0; display: flex; gap: 10px; padding: 12px 16px 14px; background: var(--page-bg); border-top: 1px solid rgba(0,0,0,.06); overflow-x: auto; scrollbar-width: none; }
.trbap-gallery-thumbs::-webkit-scrollbar { display: none; }
.trbap-thumb { flex-shrink: 0; width: 68px; height: 68px; border-radius: 8px; cursor: pointer; background: var(--page-bg); overflow: hidden; box-shadow: 0 0 0 2px transparent; transition: box-shadow .2s; }
.trbap-thumb.active { box-shadow: 0 0 0 2px var(--ba-orange); }
.trbap-thumb img { width: 100%; height: 100%; object-fit: contain; padding: 4px; background: var(--page-bg); display: block; }

/* ─── Info panel ─────────────────────────────────────────────────────────── */
.trbap-info { padding: 48px var(--page-margin) 64px; overflow-y: auto; display: flex; flex-direction: column; }

/* Breadcrumb */
.trbap-breadcrumb { font-size: 12px; color: var(--text-muted); letter-spacing: .04em; margin-bottom: 18px; }
.trbap-breadcrumb a { color: var(--text-muted); text-decoration: none; }
.trbap-breadcrumb a:hover { color: var(--ba-orange); }
.trbap-breadcrumb span { margin: 0 6px; }

/* Tags */
.trbap-tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
.trbap-tag { background: var(--tag-bg, var(--cream-dark)); color: var(--brown-dark); font-size: 11px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; padding: 5px 12px; border-radius: 50px; }
.trbap-tag.orange { background: var(--ba-orange-light); color: var(--ba-orange-dark); }
.trbap-tag.green { background: #d5edd5; color: #2e6b2e; }

/* Availability banner */
.trbap-avail { display: flex; align-items: center; gap: 12px; border-radius: 14px; padding: 14px 18px; margin-bottom: 22px; font-size: 13.5px; font-weight: 500; }
.trbap-avail--in { background: #d5edd5; color: #1e5a1e; }
.trbap-avail--order { background: var(--ba-orange-light); color: var(--ba-orange-dark); }
.trbap-avail-icon { font-size: 1.2rem; flex-shrink: 0; }
.trbap-avail-text strong { display: block; }
.trbap-avail-text span { font-size: 12px; font-weight: 400; opacity: .8; }

/* Ophaal notice */
.trbap-pickup-notice { display: flex; align-items: flex-start; gap: 12px; background: var(--ba-orange-light); border: 1px solid rgba(232,99,42,.2); border-radius: 14px; padding: 14px 18px; margin-bottom: 22px; }
.trbap-pickup-notice-icon { font-size: 1.3rem; flex-shrink: 0; margin-top: 1px; }
.trbap-pickup-notice-text { font-size: 13px; color: var(--ba-orange-dark); line-height: 1.6; }
.trbap-pickup-notice-text strong { font-size: 13.5px; display: block; margin-bottom: 2px; }

/* Title & tagline */
.trbap-info h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 400; color: var(--brown-dark); line-height: 1.15; margin-bottom: 10px; }
.trbap-tagline { font-family: 'DM Sans', sans-serif; font-style: italic; font-size: 1rem; color: var(--text-muted); margin-bottom: 24px; }

/* Price */
.trbap-price-row { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; }
.trbap-price { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--brown-dark); }
.trbap-price-compare { font-size: 1.1rem; color: var(--text-muted); text-decoration: line-through; }
.trbap-price-sub { font-size: 12px; color: var(--text-muted); margin-bottom: 22px; }

/* Section label */
.trbap-section-label { font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px; }

/* Specs grid */
.trbap-specs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 26px; }
.trbap-spec-card { background: var(--white); border-radius: 14px; padding: 14px 12px; display: flex; flex-direction: column; align-items: center; gap: 5px; border: 1px solid var(--cream-dark); }
.trbap-spec-icon { font-size: 1.4rem; }
.trbap-spec-value { font-family: 'DM Sans', sans-serif; font-size: .95rem; font-weight: 600; color: var(--brown-dark); }
.trbap-spec-label { font-size: 10.5px; color: var(--text-muted); letter-spacing: .04em; text-align: center; }

/* Variant picker */
.trbap-variants { margin-bottom: 22px; }
.trbap-variant-label { font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 10px; }
.trbap-variant-label strong { color: var(--brown-dark); font-weight: 600; text-transform: none; letter-spacing: 0; font-size: 13px; }
.trbap-variant-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.trbap-variant-pill { border: 1.5px solid var(--cream-dark); border-radius: 50px; padding: 8px 18px; min-height: 44px; display: inline-flex; align-items: center; font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--brown-dark); background: var(--white); cursor: pointer; transition: border-color .2s, background .2s; white-space: nowrap; }
.trbap-variant-pill:hover { border-color: var(--ba-orange-mid); }
.trbap-variant-pill:focus-visible { outline: 2px solid var(--ba-orange); outline-offset: 2px; }
.trbap-variant-pill.active { border-color: var(--ba-orange); background: var(--ba-orange); color: var(--white); }
.trbap-variant-pill.unavailable { opacity: .45; cursor: not-allowed; text-decoration: line-through; }

/* Qty & CTA */
.trbap-purchase { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
.trbap-qty { display: flex; align-items: center; border: 1px solid var(--cream-dark); border-radius: 50px; overflow: hidden; background: var(--white); }
.trbap-qty-btn { width: 40px; height: 44px; background: none; border: none; cursor: pointer; font-size: 1.2rem; color: var(--brown-dark); display: flex; align-items: center; justify-content: center; transition: background .15s; }
.trbap-qty-btn:hover { background: var(--cream-dark); }
.trbap-qty-num { width: 32px; text-align: center; font-weight: 500; font-size: .95rem; color: var(--brown-dark); }
.trbap-btn-primary { background: var(--brown-dark); color: var(--white); border: none; border-radius: 50px; padding: 17px 32px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; transition: background .2s, transform .15s; width: 100%; display: block; margin-bottom: 10px; }
.trbap-btn-primary:hover { background: var(--brown); transform: translateY(-1px); }
.trbap-btn-primary.ba-order { background: var(--ba-orange); }
.trbap-btn-primary.ba-order:hover { background: var(--ba-orange-dark); }
.trbap-btn-secondary { background: transparent; color: var(--brown-dark); border: 1.5px solid var(--brown-light, #c8a882); border-radius: 50px; padding: 15px 32px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; transition: background .2s; width: 100%; display: block; margin-bottom: 22px; text-align: center; text-decoration: none; }
.trbap-btn-secondary:hover { background: var(--cream-dark); }

/* USP strip */
.trbap-usps { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 30px; padding: 16px 0; border-top: 1px solid var(--cream-dark); border-bottom: 1px solid var(--cream-dark); }
.trbap-usp { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; flex: 1; }
.trbap-usp svg { width: 26px; height: 26px; color: var(--ba-orange); flex-shrink: 0; }
.trbap-usp-label { font-size: 11px; font-weight: 600; color: var(--brown-dark); line-height: 1.3; letter-spacing: .01em; }
.trbap-usp-sub { font-size: 10px; color: var(--text-muted); line-height: 1.3; }
@media (max-width: 700px) { .trbap-usps { flex-wrap: wrap; } .trbap-usp { flex: 0 0 calc(50% - 5px); } }

/* Bestelformulier */
.trbap-order-form-wrap { margin-bottom: 22px; display: none; }
.trbap-order-form-wrap.visible { display: block; }
.trbap-order-form { background: var(--ba-orange-light); border: 1px solid rgba(232,99,42,.2); border-radius: 18px; padding: 24px; }
.trbap-order-form h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 400; color: var(--ba-orange-dark); margin-bottom: 6px; }
.trbap-order-form-sub { font-size: 12.5px; color: var(--ba-orange-dark); opacity: .75; margin-bottom: 18px; }
.trbap-order-sku { display: flex; align-items: center; gap: 8px; background: var(--white); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-size: 13px; color: var(--ba-orange-dark); }
.trbap-order-sku strong { font-weight: 600; }
.trbap-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
.trbap-form-group { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
.trbap-form-group label { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ba-orange-dark); }
.trbap-form-group input, .trbap-form-group textarea { background: var(--white); border: 1px solid rgba(232,99,42,.25); border-radius: 10px; padding: 10px 14px; font-family: 'DM Sans', sans-serif; font-size: 13.5px; color: var(--brown-dark); transition: border-color .2s; outline: none; width: 100%; }
.trbap-form-group input:focus, .trbap-form-group textarea:focus { border-color: var(--ba-orange); }
.trbap-form-group textarea { min-height: 80px; resize: vertical; }
.trbap-form-group .trbap-form-optional { font-size: 10px; font-weight: 400; color: var(--text-muted); text-transform: none; letter-spacing: 0; margin-left: 4px; }
.trbap-form-qty { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.trbap-form-qty label { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ba-orange-dark); white-space: nowrap; }
.trbap-form-qty-ctrl { display: flex; align-items: center; border: 1px solid rgba(232,99,42,.25); border-radius: 50px; overflow: hidden; background: var(--white); }
.trbap-form-qty-btn { width: 36px; height: 38px; background: none; border: none; cursor: pointer; font-size: 1.1rem; color: var(--ba-orange); display: flex; align-items: center; justify-content: center; transition: background .15s; }
.trbap-form-qty-btn:hover { background: var(--ba-orange-light); }
.trbap-form-qty-num { width: 32px; text-align: center; font-weight: 600; font-size: .95rem; color: var(--ba-orange-dark); }
.trbap-btn-order-submit { background: var(--ba-orange); color: var(--white); border: none; border-radius: 50px; padding: 15px 32px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; transition: background .2s; width: 100%; }
.trbap-btn-order-submit:hover { background: var(--ba-orange-dark); }
.trbap-form-success { display: none; text-align: center; padding: 24px; }
.trbap-form-success svg { width: 40px; height: 40px; color: #2e7d32; margin-bottom: 12px; }
.trbap-form-success h4 { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--brown-dark); margin-bottom: 6px; }
.trbap-form-success p { font-size: 13px; color: var(--text-muted); }
@media (max-width: 700px) { .trbap-form-row { grid-template-columns: 1fr; } }

/* Accordion */
.trbap-accordion { border-top: 1px solid var(--cream-dark); }
.trbap-accordion-item { border-bottom: 1px solid var(--cream-dark); }
.trbap-accordion-trigger { width: 100%; background: none; border: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 16px 0; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500; color: var(--brown-dark); text-align: left; }
.trbap-accordion-body { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.trbap-accordion-body.open { max-height: 900px; }
.trbap-accordion-body-inner { padding: 0 0 18px; font-size: 13.5px; color: var(--text-muted); line-height: 1.75; }
.trbap-accordion-body-inner p { margin-bottom: 10px; }
.trbap-accordion-body-inner p:last-child { margin-bottom: 0; }
.trbap-chevron { font-size: 12px; color: var(--brown-light, #c8a882); transition: transform .25s; }
.trbap-accordion-trigger.open .trbap-chevron { transform: rotate(180deg); }

/* Specs tabel */
.trbap-specs-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.trbap-specs-table tr:nth-child(odd) { background: var(--cream); }
.trbap-specs-table td { padding: 9px 12px; color: var(--text); vertical-align: middle; }
.trbap-specs-table td:first-child { color: var(--text-muted); width: 50%; }
.trbap-icon--yes { background: #d5edd5; color: #2e7d32; border-radius: 50%; padding: 2px 6px; font-size: 12px; }
.trbap-icon--no  { background: #fde8e8; color: #c62828; border-radius: 50%; padding: 2px 6px; font-size: 12px; }

/* Related products */
.trbap-related { background: var(--page-bg); border-top: 1px solid var(--cream-dark); padding: 48px var(--page-margin) 64px; }
.trbap-related-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
.trbap-related-title { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 400; color: var(--brown-dark); }
.trbap-related-link { font-size: 13px; color: var(--ba-orange); text-decoration: none; border-bottom: 1px solid rgba(232,99,42,.3); }
.trbap-related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.trbap-related-card { background: var(--white); border-radius: 16px; overflow: hidden; border: 1px solid var(--cream-dark); text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; }
.trbap-related-card:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(0,0,0,.08); }
.trbap-related-card-img { aspect-ratio: 1; background: var(--page-bg); overflow: hidden; }
.trbap-related-card-img img { width: 100%; height: 100%; object-fit: contain; padding: 12px; }
.trbap-related-card-body { padding: 12px 14px 14px; flex: 1; }
.trbap-related-card-name { font-size: 13.5px; font-weight: 600; color: var(--brown-dark); line-height: 1.3; margin-bottom: 4px; }
.trbap-related-card-price { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--brown-dark); }
.trbap-related-card-badge { font-size: 10px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; padding: 3px 9px; border-radius: 50px; margin-top: 6px; display: inline-block; }
.trbap-related-card-badge.stock { background: #d5edd5; color: #2e6b2e; }
.trbap-related-card-badge.order { background: var(--ba-orange-light); color: var(--ba-orange-dark); }

/* Mobile sticky CTA */
@media (max-width: 700px) {
  .trbap-grid { grid-template-columns: 1fr; min-height: auto; }
  .trbap-gallery { position: relative; height: auto; top: 0; }
  .trbap-gallery-main { height: 60vw; }
  .trbap-info { padding: 28px 4vw 100px; }
  .trbap-sticky-atc { display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; background: var(--white); border-top: 1px solid var(--cream-dark); padding: 12px 16px; gap: 10px; align-items: center; box-shadow: 0 -4px 20px rgba(0,0,0,.08); }
  .trbap-sticky-price { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--brown-dark); white-space: nowrap; }
  .trbap-sticky-btn { flex: 1; background: var(--ba-orange); color: var(--white); border: none; border-radius: 50px; padding: 14px 20px; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; }
  .trbap-related-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 701px) { .trbap-sticky-atc { display: none; } }
@media (max-width: 1100px) { .trbap-related-grid { grid-template-columns: repeat(3, 1fr); } }
@media (prefers-reduced-motion: reduce) { .trbap-wrap *, .trbap-wrap *::before, .trbap-wrap *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }
</style>

{%- assign cur = product -%}

{%- if cur.selected_or_first_available_variant.featured_image -%}
  {%- assign init_img = cur.selected_or_first_available_variant.featured_image | image_url: width: 900 -%}
  {%- assign init_alt = cur.selected_or_first_available_variant.featured_image.alt | default: cur.title | escape -%}
{%- else -%}
  {%- assign init_img = cur.featured_image | image_url: width: 900 -%}
  {%- assign init_alt = cur.featured_image.alt | default: cur.title | escape -%}
{%- endif -%}

{%- assign _available = cur.available -%}

{%- comment -%} Materiaal detectie uit tags {%- endcomment -%}
{%- assign _vaatwasser = false -%}
{%- assign _cadeau = false -%}
{%- assign _textiel = false -%}
{%- for tag in cur.tags -%}
  {%- assign _tl = tag | downcase -%}
  {%- if _tl contains 'vaatwasser' -%}{%- assign _vaatwasser = true -%}{%- endif -%}
  {%- if _tl contains 'cadeau' or _tl contains 'gift' -%}{%- assign _cadeau = true -%}{%- endif -%}
  {%- if _tl contains 'textiel' or _tl contains 'stof' -%}{%- assign _textiel = true -%}{%- endif -%}
{%- endfor -%}

<div class="trbap-wrap" itemscope itemtype="https://schema.org/Product">
  <meta itemprop="name" content="{{ cur.title | escape }}">
  <meta itemprop="brand" content="Blond Amsterdam">
  {%- if cur.featured_image -%}<meta itemprop="image" content="{{ cur.featured_image | image_url: width: 900 }}">{%- endif -%}
  <meta itemprop="description" content="{{ cur.description | strip_html | truncate: 200 | escape }}">
  <meta itemprop="sku" content="{{ cur.selected_or_first_available_variant.sku }}">

  <div class="trbap-grid">
    <!-- ── Gallery ──────────────────────────────────────────────────── -->
    <aside class="trbap-gallery" aria-label="Productafbeeldingen">
      <div class="trbap-gallery-main" id="trbap-main-img-wrap">
        <img
          id="trbap-main-img"
          src="{{ init_img }}"
          alt="{{ init_alt }} – Blond Amsterdam bij Tante Rie Borne"
          loading="eager"
          width="900"
          height="900">
        <span class="trbap-gallery-badge" aria-hidden="true">Blond Amsterdam</span>
        {%- if cur.type != blank -%}
          <span class="trbap-gallery-brand" aria-hidden="true">{{ cur.type }}</span>
        {%- endif -%}
      </div>
      {%- if cur.images.size > 1 -%}
        <div class="trbap-gallery-thumbs" role="list" aria-label="Productfoto's">
          {%- for img in cur.images limit: 8 -%}
            <button
              class="trbap-thumb{% if forloop.first %} active{% endif %}"
              type="button"
              data-trbap-thumb
              data-src="{{ img | image_url: width: 900 }}"
              data-alt="{{ img.alt | default: cur.title | escape }}"
              aria-label="Afbeelding {{ forloop.index }}"
              role="listitem">
              <img src="{{ img | image_url: width: 140 }}" alt="{{ img.alt | default: cur.title | escape }}" loading="lazy" width="68" height="68">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </aside>

    <!-- ── Info panel ───────────────────────────────────────────────── -->
    <div class="trbap-info">
      <nav class="trbap-breadcrumb" aria-label="Kruimelpad">
        <a href="/">Home</a><span aria-hidden="true">›</span>
        {%- if cur.collections.first -%}
          <a href="{{ cur.collections.first.url }}">{{ cur.collections.first.title }}</a><span aria-hidden="true">›</span>
        {%- endif -%}
        <span>{{ cur.title }}</span>
      </nav>

      <!-- Tags -->
      <div class="trbap-tag-row">
        <span class="trbap-tag orange">Blond Amsterdam</span>
        {%- if cur.type != blank -%}<span class="trbap-tag">{{ cur.type }}</span>{%- endif -%}
        {%- if _cadeau -%}<span class="trbap-tag green">Cadeau-tip</span>{%- endif -%}
        {%- for tag in cur.tags -%}
          {%- assign _tl = tag | downcase -%}
          {%- if _tl == 'nieuw' or _tl == 'new' -%}<span class="trbap-tag orange">Nieuw</span>{%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Beschikbaarheid -->
      {%- if _available -%}
        <div class="trbap-avail trbap-avail--in" role="status">
          <span class="trbap-avail-icon" aria-hidden="true">{%- render 'tr-icon', name: 'check' -%}</span>
          <div class="trbap-avail-text">
            <strong>Op voorraad</strong>
            <span>Vandaag op te halen</span>
          </div>
        </div>
      {%- else -%}
        <div class="trbap-avail trbap-avail--order" role="status">
          <span class="trbap-avail-icon" aria-hidden="true">{%- render 'tr-icon', name: 'package' -%}</span>
          <div class="trbap-avail-text">
            <strong>Te bestellen</strong>
            <span>Wij bellen je zodra het klaar ligt</span>
          </div>
        </div>
      {%- endif -%}

      <!-- Ophaal notice -->
      <div class="trbap-pickup-notice">
        <span class="trbap-pickup-notice-icon" aria-hidden="true">{%- render 'tr-icon', name: 'store' -%}</span>
        <div class="trbap-pickup-notice-text">
          <strong>Alleen afhalen, geen verzending</strong>
          Bakkerssteeg 6, Borne &nbsp;·&nbsp; Di t/m za 10:00–17:00
        </div>
      </div>

      <!-- Titel -->
      <h1 itemprop="name">{{ cur.title }}</h1>
      <p class="trbap-tagline">
        {%- if section.settings.tagline != blank -%}
          {{ section.settings.tagline }}
        {%- else -%}
          {{ cur.type | default: 'Blond Amsterdam' }}, vrolijk Dutch design bij Tante Rie
        {%- endif -%}
      </p>

      <!-- Prijs -->
      <div class="trbap-price-row" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <meta itemprop="priceCurrency" content="EUR">
        <meta itemprop="availability" content="{%- if _available -%}https://schema.org/InStock{%- else -%}https://schema.org/PreOrder{%- endif -%}">
        <meta itemprop="availableAtOrFrom" content="Tante Rie, Bakkerssteeg 6, Borne">
        <span class="trbap-price" id="trbap-price">
          <meta itemprop="price" content="{{ cur.selected_or_first_available_variant.price | divided_by: 100.0 }}">
          {{ cur.selected_or_first_available_variant.price | money }}
        </span>
        {%- if cur.compare_at_price > cur.price -%}
          <span class="trbap-price-compare">{{ cur.compare_at_price | money }}</span>
        {%- endif -%}
      </div>
      <p class="trbap-price-sub">Incl. BTW &nbsp;·&nbsp; Alleen afhalen in Borne</p>

      <!-- Specs mini-grid -->
      <p class="trbap-section-label">Productkenmerken</p>
      <div class="trbap-specs-grid">
        <div class="trbap-spec-card">
          <span class="trbap-spec-icon" aria-hidden="true">{%- render 'tr-icon', name: 'flower' -%}</span>
          <span class="trbap-spec-value">Dutch design</span>
          <span class="trbap-spec-label">Stijl</span>
        </div>
        <div class="trbap-spec-card">
          <span class="trbap-spec-icon" aria-hidden="true">{%- if _cadeau -%}{%- render 'tr-icon', name: 'gift' -%}{%- else -%}{%- render 'tr-icon', name: 'home' -%}{%- endif -%}</span>
          <span class="trbap-spec-value">{%- if _cadeau -%}Cadeau-tip{%- else -%}Woonaccessoire{%- endif -%}</span>
          <span class="trbap-spec-label">Categorie</span>
        </div>
        <div class="trbap-spec-card">
          <span class="trbap-spec-icon" aria-hidden="true">{%- if _vaatwasser -%}{%- render 'tr-icon', name: 'check' -%}{%- elsif _textiel -%}{%- render 'tr-icon', name: 'basket' -%}{%- else -%}{%- render 'tr-icon', name: 'hand' -%}{%- endif -%}</span>
          <span class="trbap-spec-value">{%- if _vaatwasser -%}Vaatwasser ok{%- elsif _textiel -%}Machinewas{%- else -%}Handwas{%- endif -%}</span>
          <span class="trbap-spec-label">Onderhoud</span>
        </div>
      </div>

      <!-- Varianten -->
      {%- if cur.variants.size > 1 -%}
        <script type="application/json" id="trbap-variant-data">
        {
          "variants": [
            {%- for v in cur.variants -%}
              {%- if v.featured_image -%}{%- assign _v_img = v.featured_image | image_url: width: 900 -%}{%- else -%}{%- assign _v_img = '' -%}{%- endif -%}
              {
                "id": {{ v.id }},
                "price": "{{ v.price | money }}",
                "available": {{ v.available }},
                "options": {{ v.options | json }},
                "image": "{{ _v_img }}",
                "alt": "{{ v.featured_image.alt | default: v.title | escape }}",
                "sku": {{ v.sku | json }},
                "ean": {{ v.barcode | json }},
                "title": {{ v.title | replace: 'Default Title', '' | json }},
                "weight": {{ v.weight | times: 1000 | round }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          "initialOptions": {{ cur.selected_or_first_available_variant.options | json }}
        }
        </script>
        <div class="trbap-variants" data-trbap-variants>
          {%- for opt in cur.options_with_values -%}
            {%- assign _opt_idx = forloop.index0 -%}
            {%- assign _opt_sel = cur.selected_or_first_available_variant.options[_opt_idx] -%}
            <div class="trbap-variants-group" data-option-index="{{ _opt_idx }}">
              <p class="trbap-variant-label">{{ opt.name }}: <strong data-trbap-opt-val="{{ _opt_idx }}">{{ _opt_sel }}</strong></p>
              <div class="trbap-variant-pills">
                {%- for val in opt.values -%}
                  <button
                    type="button"
                    class="trbap-variant-pill{% if val == _opt_sel %} active{% endif %}"
                    data-trbap-pill
                    data-option-index="{{ _opt_idx }}"
                    data-value="{{ val | escape }}"
                    aria-pressed="{%- if val == _opt_sel -%}true{%- else -%}false{%- endif -%}">
                    {{ val }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Qty + ATC -->
      <div class="trbap-purchase">
        <div class="trbap-qty" aria-label="Aantal">
          <button type="button" class="trbap-qty-btn" id="trbap-qty-minus" aria-label="Minder">−</button>
          <span class="trbap-qty-num" id="trbap-qty-val" aria-live="polite">1</span>
          <button type="button" class="trbap-qty-btn" id="trbap-qty-plus" aria-label="Meer">+</button>
        </div>
      </div>

      {%- if _available -%}
        <button
          type="button"
          id="trbap-atc"
          class="trbap-btn-primary"
          data-variant-id="{{ cur.selected_or_first_available_variant.id }}"
          data-tr-atc
          aria-label="Voeg toe aan winkelwagen">
          In winkelwagen
        </button>
      {%- else -%}
        <button
          type="button"
          id="trbap-atc"
          class="trbap-btn-primary ba-order"
          data-variant-id="{{ cur.selected_or_first_available_variant.id }}"
          aria-label="Bestel dit product"
          aria-expanded="false"
          aria-controls="trbap-order-form-wrap">
          Bestellen
        </button>

        <!-- Bestelformulier -->
        <div class="trbap-order-form-wrap" id="trbap-order-form-wrap" aria-live="polite">
          <div class="trbap-order-form">
            <h3>Stuur een bestelverzoek</h3>
            <p class="trbap-order-form-sub">Wij bellen of mailen je zodra het klaar ligt.</p>

            <div class="trbap-order-sku" id="trbap-sku-display" aria-live="polite">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a4 4 0 0 0-8 0v2"/></svg>
              <span>Geselecteerd: <strong id="trbap-sku-label">{{ cur.title }}{% if cur.selected_or_first_available_variant.title != 'Default Title' %} – {{ cur.selected_or_first_available_variant.title }}{% endif %}</strong></span>
            </div>

            <form method="post" action="/contact#trbap-order-form-wrap" id="trbap-contact-form" accept-charset="UTF-8">
              <input type="hidden" name="form_type" value="contact">
              <input type="hidden" name="utf8" value="✓">
              <input type="hidden" name="contact[subject]" value="Bestelverzoek Blond Amsterdam – {{ cur.title }}">
              <input type="hidden" name="contact[body_prefix]" id="trbap-hidden-product" value="Product: {{ cur.title }} | SKU: {{ cur.selected_or_first_available_variant.sku }} | Variant: {{ cur.selected_or_first_available_variant.title }}">

              <div class="trbap-form-row">
                <div class="trbap-form-group">
                  <label for="trbap-naam">Naam</label>
                  <input type="text" id="trbap-naam" name="contact[naam]" placeholder="Voor- en achternaam" required autocomplete="name">
                </div>
                <div class="trbap-form-group">
                  <label for="trbap-tel">Telefoon</label>
                  <input type="tel" id="trbap-tel" name="contact[telefoon]" placeholder="06 12345678" required autocomplete="tel">
                </div>
              </div>

              <div class="trbap-form-group">
                <label for="trbap-email">E-mailadres</label>
                <input type="email" id="trbap-email" name="contact[email]" placeholder="jouw@email.nl" required autocomplete="email">
              </div>

              <div class="trbap-form-group">
                <label for="trbap-adres">Adres <span class="trbap-form-optional">(optioneel)</span></label>
                <input type="text" id="trbap-adres" name="contact[adres]" placeholder="Straat + huisnummer, postcode, plaats" autocomplete="street-address">
              </div>

              <div class="trbap-form-qty">
                <label>Aantal</label>
                <div class="trbap-form-qty-ctrl">
                  <button type="button" class="trbap-form-qty-btn" id="trbap-form-qty-minus" aria-label="Minder">−</button>
                  <span class="trbap-form-qty-num" id="trbap-form-qty-val" aria-live="polite">1</span>
                  <button type="button" class="trbap-form-qty-btn" id="trbap-form-qty-plus" aria-label="Meer">+</button>
                </div>
                <input type="hidden" name="contact[aantal]" id="trbap-form-qty-input" value="1">
              </div>

              <div class="trbap-form-group">
                <label for="trbap-opmerkingen">Opmerkingen <span class="trbap-form-optional">(optioneel)</span></label>
                <textarea id="trbap-opmerkingen" name="contact[opmerkingen]" placeholder="Bijv. gewenste ophaaldatum, kleurvoorkeur…"></textarea>
              </div>

              <button type="submit" class="trbap-btn-order-submit">Verstuur verzoek</button>
            </form>

            <div class="trbap-form-success" id="trbap-form-success" role="alert">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <h4>Gelukt</h4>
              <p>We bellen of mailen je binnenkort.</p>
            </div>
          </div>
        </div>
      {%- endif -%}

      <a href="{{ cur.collections.first.url | default: '/collections/blond-amsterdam' }}" class="trbap-btn-secondary">
        Terug naar de Blond Amsterdam collectie
      </a>

      <!-- USP balk -->
      <div class="trbap-usps" aria-label="Waarom Blond Amsterdam bij Tante Rie">

        <div class="trbap-usp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2C8 2 5 5 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-4-3-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>
          </svg>
          <span class="trbap-usp-label">Alleen in Borne</span>
          <span class="trbap-usp-sub">Afhalen in de winkel</span>
        </div>

        <div class="trbap-usp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
          <span class="trbap-usp-label">Vrolijk design</span>
          <span class="trbap-usp-sub">Kleur in huis</span>
        </div>

        <div class="trbap-usp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="trbap-usp-label">Cadeau-tip</span>
          <span class="trbap-usp-sub">Altijd raak</span>
        </div>

        <div class="trbap-usp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span class="trbap-usp-label">Dutch design</span>
          <span class="trbap-usp-sub">Gemaakt in NL</span>
        </div>

        <div class="trbap-usp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a4 4 0 0 0-8 0v2"/><line x1="12" y1="12" x2="12" y2="15"/>
          </svg>
          <span class="trbap-usp-label">Hele collectie</span>
          <span class="trbap-usp-sub">Altijd te bestellen</span>
        </div>

      </div>

      <!-- Accordion -->
      <div class="trbap-accordion" id="trbap-accordion">

        <div class="trbap-accordion-item">
          <button type="button" class="trbap-accordion-trigger open" aria-expanded="true" data-trbap-acc>
            Productomschrijving
            <span class="trbap-chevron" aria-hidden="true">▾</span>
          </button>
          <div class="trbap-accordion-body open" role="region">
            <div class="trbap-accordion-body-inner" itemprop="description">
              {%- if cur.description != blank -%}
                {{ cur.description }}
              {%- else -%}
                <p>Bekijk de omschrijving van dit Blond Amsterdam product in de webshop.</p>
              {%- endif -%}
            </div>
          </div>
        </div>

        <div class="trbap-accordion-item">
          <button type="button" class="trbap-accordion-trigger" aria-expanded="false" data-trbap-acc>
            Specificaties
            <span class="trbap-chevron" aria-hidden="true">▾</span>
          </button>
          <div class="trbap-accordion-body" role="region">
            <div class="trbap-accordion-body-inner">
              <table class="trbap-specs-table" aria-label="Productspecificaties">
                <tr><td>Artikelnummer</td><td id="trbap-spec-sku">{{ cur.selected_or_first_available_variant.sku | default: '–' }}</td></tr>
                <tr><td>EAN</td><td id="trbap-spec-ean">{{ cur.selected_or_first_available_variant.barcode | default: '–' }}</td></tr>
                <tr><td>Variant</td><td id="trbap-spec-variant">{{ cur.selected_or_first_available_variant.title | replace: 'Default Title', '–' }}</td></tr>
                <tr><td>Gewicht</td><td id="trbap-spec-weight">
                  {%- assign _vw = cur.selected_or_first_available_variant.weight -%}
                  {%- if _vw > 0 -%}{{ _vw | times: 1000 | round }} g{%- else -%}–{%- endif -%}
                </td></tr>
                <tr><td>Merk</td><td>Blond Amsterdam</td></tr>
                <tr><td>Design</td><td>Dutch design</td></tr>
                {%- if cur.metafields.custom.inhoud_ml != blank -%}
                  <tr><td>Inhoud</td><td>{{ cur.metafields.custom.inhoud_ml }} ml</td></tr>
                {%- endif -%}
                {%- if cur.metafields.custom.hoogte_cm != blank -%}
                  <tr><td>Hoogte</td><td>{{ cur.metafields.custom.hoogte_cm }} cm</td></tr>
                {%- endif -%}
                {%- if cur.metafields.custom.diameter_cm != blank -%}
                  <tr><td>Diameter</td><td>{{ cur.metafields.custom.diameter_cm }} cm</td></tr>
                {%- endif -%}
                <tr><td>Vaatwasserbestendig</td><td><span class="{%- if _vaatwasser -%}trbap-icon--yes{%- else -%}trbap-icon--no{%- endif -%}" aria-hidden="true">{%- if _vaatwasser -%}✓{%- else -%}✗{%- endif -%}</span> {%- if _vaatwasser -%}Ja{%- else -%}Handwas aanbevolen{%- endif -%}</td></tr>
              </table>
            </div>
          </div>
        </div>

        <div class="trbap-accordion-item">
          <button type="button" class="trbap-accordion-trigger" aria-expanded="false" data-trbap-acc>
            Ophaalinformatie
            <span class="trbap-chevron" aria-hidden="true">▾</span>
          </button>
          <div class="trbap-accordion-body" role="region">
            <div class="trbap-accordion-body-inner">
              <p><strong>Tante Rie verzendt niet.</strong> Je haalt alles op in de winkel.</p>
              <p><strong>Adres:</strong> Bakkerssteeg 6, 7622 GX Borne (Twente)</p>
              <p><strong>Openingstijden:</strong><br>
                Dinsdag t/m zaterdag &nbsp;10:00 – 17:00 uur<br>
                Maandag &amp; zondag gesloten
              </p>
              {%- unless _available -%}
                <p><strong>Op bestelling:</strong> Niet in de winkel, maar altijd te bestellen. Na je verzoek spreken we een ophaaldatum af.</p>
              {%- endunless -%}
              <p>Vragen? <a href="/pages/contact" style="color:var(--ba-orange)">Neem contact op</a> of bel <a href="tel:+31638291189" style="color:var(--ba-orange)">+31 6 38291189</a>.</p>
            </div>
          </div>
        </div>

      </div><!-- /accordion -->
    </div><!-- /info -->
  </div><!-- /grid -->

  <!-- ── Gerelateerde producten ──────────────────────────────────────── -->
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="trbap-related" aria-labelledby="trbap-related-heading">
      <div class="trbap-related-header">
        <h2 class="trbap-related-title" id="trbap-related-heading">Meer uit de Blond Amsterdam collectie</h2>
        <a href="{{ cur.collections.first.url | default: '/collections/blond-amsterdam' }}" class="trbap-related-link">Bekijk alles →</a>
      </div>
      <div class="trbap-related-grid">
        {%- for rp in recommendations.products limit: 4 -%}
          <a href="{{ rp.url }}" class="trbap-related-card">
            <div class="trbap-related-card-img">
              {%- if rp.featured_image -%}
                <img src="{{ rp.featured_image | image_url: width: 400 }}" alt="{{ rp.featured_image.alt | default: rp.title | escape }}" loading="lazy" width="200" height="200">
              {%- endif -%}
            </div>
            <div class="trbap-related-card-body">
              <p class="trbap-related-card-name">{{ rp.title }}</p>
              <p class="trbap-related-card-price">{{ rp.price | money }}</p>
              <span class="trbap-related-card-badge {% if rp.available %}stock{% else %}order{% endif %}">
                {%- if rp.available -%}Op voorraad{%- else -%}Te bestellen{%- endif -%}
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <!-- ── Mobile sticky ATC ──────────────────────────────────────────── -->
  <div class="trbap-sticky-atc" aria-hidden="true">
    <span class="trbap-sticky-price" id="trbap-sticky-price">{{ cur.selected_or_first_available_variant.price | money }}</span>
    <button type="button" class="trbap-sticky-btn" id="trbap-sticky-btn">
      {%- if _available -%}In winkelwagen{%- else -%}Bestellen{%- endif -%}
    </button>
  </div>

  <!-- ── JSON-LD BreadcrumbList + Product ───────────────────────────── -->
  {%- render 'tr-product-schema', product: cur, brand_name: 'Blond Amsterdam' -%}

</div>

<script>
(function () {
  window._trbapProductTitle = {{ cur.title | json }};

  /* ── Thumb gallery ── */
  var thumbs = document.querySelectorAll('[data-trbap-thumb]');
  var mainImg = document.getElementById('trbap-main-img');
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      if (mainImg) { mainImg.src = thumb.dataset.src; mainImg.alt = thumb.dataset.alt; }
      thumbs.forEach(function (t) { t.classList.remove('active'); });
      thumb.classList.add('active');
    });
  });

  /* ── Accordion ── */
  document.querySelectorAll('[data-trbap-acc]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !expanded);
      btn.classList.toggle('open', !expanded);
      var body = btn.nextElementSibling;
      if (body) body.classList.toggle('open', !expanded);
    });
  });

  /* ── Qty (hoofd) ── */
  var qty = 1;
  var qtyEl = document.getElementById('trbap-qty-val');
  document.getElementById('trbap-qty-minus') && document.getElementById('trbap-qty-minus').addEventListener('click', function () { if (qty > 1) { qty--; if (qtyEl) qtyEl.textContent = qty; } });
  document.getElementById('trbap-qty-plus') && document.getElementById('trbap-qty-plus').addEventListener('click', function () { qty++; if (qtyEl) qtyEl.textContent = qty; });

  /* ── Qty (bestelformulier) ── */
  var formQty = 1;
  var formQtyEl = document.getElementById('trbap-form-qty-val');
  var formQtyInput = document.getElementById('trbap-form-qty-input');
  function setFormQty(n) {
    formQty = Math.max(1, n);
    if (formQtyEl) formQtyEl.textContent = formQty;
    if (formQtyInput) formQtyInput.value = formQty;
  }
  document.getElementById('trbap-form-qty-minus') && document.getElementById('trbap-form-qty-minus').addEventListener('click', function () { setFormQty(formQty - 1); });
  document.getElementById('trbap-form-qty-plus') && document.getElementById('trbap-form-qty-plus').addEventListener('click', function () { setFormQty(formQty + 1); });

  /* ── Bestellen knop — toggle formulier ── */
  var bestellenBtn = document.getElementById('trbap-atc');
  var orderFormWrap = document.getElementById('trbap-order-form-wrap');
  if (bestellenBtn && orderFormWrap) {
    bestellenBtn.addEventListener('click', function () {
      var open = orderFormWrap.classList.toggle('visible');
      bestellenBtn.setAttribute('aria-expanded', open);
      if (open) { orderFormWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
    });
  }

  /* ── Shopify form success detectie ── */
  if (window.location.hash === '#trbap-order-form-wrap') {
    var successEl = document.getElementById('trbap-form-success');
    var formEl = document.getElementById('trbap-contact-form');
    if (successEl && formEl) {
      var posted = document.referrer.indexOf('/contact') > -1;
      if (posted) { formEl.style.display = 'none'; successEl.style.display = 'block'; }
    }
    if (orderFormWrap) { orderFormWrap.classList.add('visible'); orderFormWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
  }

  /* ── Variant picker ── */
  var variantWrap = document.querySelector('[data-trbap-variants]');
  var atcBtn = document.getElementById('trbap-atc');
  var stickyBtn = document.getElementById('trbap-sticky-btn');
  var priceEl = document.getElementById('trbap-price');
  var stickyPriceEl = document.getElementById('trbap-sticky-price');
  var rawData = document.getElementById('trbap-variant-data');
  if (!variantWrap || !rawData) return;

  var data = JSON.parse(rawData.textContent);
  var selectedOpts = data.initialOptions.slice();

  function matchVariant() {
    return data.variants.find(function (v) {
      return v.options.every(function (o, i) { return o === selectedOpts[i]; });
    });
  }

  function updateUI(v) {
    if (!v) return;
    if (priceEl) priceEl.innerHTML = '<meta itemprop="price" content="' + (v.price.replace(/[^0-9,]/g, '').replace(',', '.')) + '">' + v.price;
    if (stickyPriceEl) stickyPriceEl.textContent = v.price;
    if (atcBtn) {
      atcBtn.dataset.variantId = v.id;
      atcBtn.disabled = false;
      atcBtn.textContent = v.available ? 'In winkelwagen' : 'Bestel nu';
      atcBtn.classList.toggle('ba-order', !v.available);
    }
    if (stickyBtn) stickyBtn.textContent = v.available ? 'In winkelwagen' : 'Bestel nu';
    if (v.image && mainImg) { mainImg.src = v.image; mainImg.alt = v.alt || ''; }
    var specSku     = document.getElementById('trbap-spec-sku');
    var specEan     = document.getElementById('trbap-spec-ean');
    var specVariant = document.getElementById('trbap-spec-variant');
    var specWeight  = document.getElementById('trbap-spec-weight');
    if (specSku)     specSku.textContent     = v.sku     || '–';
    if (specEan)     specEan.textContent     = v.ean     || '–';
    if (specVariant) specVariant.textContent = v.title   || '–';
    if (specWeight)  specWeight.textContent  = v.weight > 0 ? v.weight + ' g' : '–';
    var skuLabel = document.getElementById('trbap-sku-label');
    var hiddenProduct = document.getElementById('trbap-hidden-product');
    if (skuLabel && v.options) {
      skuLabel.textContent = (window._trbapProductTitle || '') + (v.options.join(', ') !== 'Default Title' ? ' – ' + v.options.join(' / ') : '');
    }
    if (hiddenProduct && v.options) {
      hiddenProduct.value = 'Product: ' + (window._trbapProductTitle || '') + ' | Variant: ' + v.options.join(' / ') + ' | Variant ID: ' + v.id;
    }
  }

  document.querySelectorAll('[data-trbap-pill]').forEach(function (pill) {
    pill.addEventListener('click', function () {
      var idx = parseInt(pill.dataset.optionIndex, 10);
      var val = pill.dataset.value;
      selectedOpts[idx] = val;
      variantWrap.querySelectorAll('[data-option-index="' + idx + '"]').forEach(function (p) {
        p.classList.toggle('active', p.dataset.value === val);
        p.setAttribute('aria-pressed', p.dataset.value === val);
      });
      var labelEl = variantWrap.querySelector('[data-trbap-opt-val="' + idx + '"]');
      if (labelEl) labelEl.textContent = val;
      updateUI(matchVariant());
    });
  });

  /* ── Sticky btn mirrors main ATC ── */
  if (stickyBtn && atcBtn) {
    stickyBtn.addEventListener('click', function () { atcBtn.click(); });
  }
})();
</script>

