    { "type": "textarea", "id": "about_text_1", "label": "Eerste alinea" },
    { "type": "textarea", "id": "about_text_2", "label": "Tweede alinea" },
    { "type": "textarea", "id": "about_text_3", "label": "Derde alinea" },
    { "type": "text", "id": "about_cta_text", "label": "Knop tekst", "default": "Ontdek ons assortiment" },
    { "type": "url", "id": "about_cta_url", "label": "Knop link" }
  ],
  "blocks": [
