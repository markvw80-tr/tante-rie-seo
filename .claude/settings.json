{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python3 scripts/sessiestart.py*)",
      "Bash(python3 scripts/mailbox.py lijst*)",
      "Bash(python3 scripts/mailbox.py lees*)",
      "Bash(python3 scripts/mailbox.py verwerkt*)",
      "Bash(python3 scripts/mailbox.py stuur*)",
      "Bash(python3 scripts/mailbox.py status*)",
      "Bash(python3 scripts/pim_regels.py nieuw*)",
      "Bash(python3 scripts/pim_regels.py controleer*)",
      "Bash(python3 scripts/pim_regels.py stuur*)",
      "Bash(graphify query*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/blokkeer_shopify_schrijven.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stuurpoort.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tekstlint.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/changelogherinnering.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/sessiestart.py\"",
            "timeout": 40
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "tante-rie-huisregels@tante-rie": true
  },
  "extraKnownMarketplaces": {
    "tante-rie": {
      "source": {
        "source": "directory",
        "path": "/Users/markvanwijk/tante-rie/tante-rie-hq"
      }
    }
  }
}
